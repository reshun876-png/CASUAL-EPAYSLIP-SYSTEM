{
  "entities": {
    "UserAccount": {
      "title": "User Account",
      "description": "System user account with role-based access control for Ghana Health Service Essikado Hospital payroll.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["super_admin", "hr_payroll", "supervisor", "auditor", "staff"] },
        "department": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "staffId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "username", "fullName", "email", "role", "title"]
    },
    "TemporalStaff": {
      "title": "Temporal Staff Member",
      "description": "Temporal, locum, or contract healthcare worker record at Essikado Hospital.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "staffId": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 128 },
        "cadre": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 128 },
        "ghanaCardNo": { "type": "string", "maxLength": 32 },
        "ssnitNo": { "type": "string", "maxLength": 32 },
        "standardMonthlyRate": { "type": "number" },
        "dailyRate": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "accountOrMomoNumber": { "type": "string", "maxLength": 64 },
        "bankName": { "type": "string", "maxLength": 128 },
        "contractType": { "type": "string", "maxLength": 64 },
        "contractStartDate": { "type": "string", "maxLength": 32 },
        "contractEndDate": { "type": "string", "maxLength": 32 },
        "contractDurationMonths": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "On Leave", "Suspended", "Contract Ended"] },
        "registeredAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "staffId", "fullName", "cadre", "department", "ghanaCardNo", "standardMonthlyRate", "status"]
    },
    "JobCategory": {
      "title": "Job Category",
      "description": "Hospital clinical or administrative job cadre with standard pay and allowance rates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 128 },
        "defaultMonthlyRate": { "type": "number" },
        "defaultDailyRate": { "type": "number" },
        "defaultNightShiftRate": { "type": "number" },
        "defaultEmergencyCallRate": { "type": "number" },
        "defaultRiskAllowance": { "type": "number" },
        "description": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "name", "department", "defaultMonthlyRate", "defaultDailyRate"]
    },
    "PayrollCycle": {
      "title": "Payroll Cycle",
      "description": "Monthly payroll processing run with status workflow.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "monthYear": { "type": "string", "maxLength": 64 },
        "periodStart": { "type": "string", "maxLength": 32 },
        "periodEnd": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["Draft", "Submitted for Audit", "Audit Approved", "Final Approved", "Disbursed"] },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "auditedBy": { "type": "string", "maxLength": 128 },
        "auditedAt": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 512 }
      },
      "required": ["id", "monthYear", "periodStart", "periodEnd", "status"]
    },
    "Payslip": {
      "title": "Staff Payslip",
      "description": "Individual monthly temporal staff payslip breakdown with SHA-256 security hash.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "payslipSerialNo": { "type": "string", "maxLength": 64 },
        "payrollCycleId": { "type": "string", "maxLength": 128 },
        "staffId": { "type": "string", "maxLength": 64 },
        "staffName": { "type": "string", "maxLength": 128 },
        "cadre": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 128 },
        "monthYear": { "type": "string", "maxLength": 64 },
        "grossPay": { "type": "number" },
        "totalTaxable": { "type": "number" },
        "graTaxDeduction": { "type": "number" },
        "totalDeductions": { "type": "number" },
        "netPay": { "type": "number" },
        "securityHash": { "type": "string", "maxLength": 128 },
        "isLocked": { "type": "boolean" }
      },
      "required": ["id", "payslipSerialNo", "payrollCycleId", "staffId", "staffName", "grossPay", "netPay", "securityHash"]
    },
    "AuditLogEntry": {
      "title": "Audit Log Entry",
      "description": "Immutable institutional log entry for compliance tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "userName": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 512 }
      },
      "required": ["id", "timestamp", "userName", "userRole", "action", "details"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "System user profiles with role-based access control."
    },
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/TemporalStaff" },
      "description": "Temporal and locum healthcare worker master records."
    },
    "/jobCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/JobCategory" },
      "description": "Hospital cadres and rate benchmarks."
    },
    "/payrollCycles/{cycleId}": {
      "schema": { "$ref": "#/entities/PayrollCycle" },
      "description": "Monthly payroll cycles and approvals."
    },
    "/payslips/{payslipId}": {
      "schema": { "$ref": "#/entities/Payslip" },
      "description": "Generated monthly electronic payslips."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Immutable security and audit trail records."
    }
  }
}
